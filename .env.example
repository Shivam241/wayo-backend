NODE_ENV=development
PORT=3101
LOG_LEVEL=info

DATABASE_URL=postgres://wayo:wayo@localhost:5433/wayo
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://wayo:wayo@localhost:27017/wayo?authSource=admin

# Leave the Firebase block empty to run without cloud credentials.
# ALLOW_DEV_AUTH accepts `Authorization: Bearer dev:<uid>`. Defaults to false when
# NODE_ENV=production; see DEPLOY.md before enabling it on a hosted service.
ALLOW_DEV_AUTH=true
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# local | google | mapbox. `local` uses a straight-line estimate, so the stack
# runs with no mapping key and no billing.
MAPS_PROVIDER=local
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# Matching tolerances and weights (weights should sum to 1).
MATCH_ALGO_VERSION=v1.0.0
MATCH_PICKUP_RADIUS_KM=2
MATCH_DROP_RADIUS_KM=2
MATCH_TIME_WINDOW_MIN=30
MATCH_MAX_DETOUR_KM=5
MATCH_MAX_DETOUR_MIN=15
MATCH_MIN_SCORE=0.35

# Contribution policy. Phase 1 displays an amount; it never moves money.
COST_CURRENCY=INR
COST_DRIVER_SHARE=0.25
COST_ROUND_TO=5
COST_MIN=10
COST_MAX=2000
COST_REGION=IN-DL
COST_DEFAULT_KMPL=15

# Wall-clock timezone for ride departure times and recurrence days.
APP_TIMEZONE=Asia/Kolkata

# 0.0.0.0 so an Android emulator (10.0.2.2) and containers can reach the API.
HOST=0.0.0.0

# --- deployment -------------------------------------------------------------
# Managed Postgres (Render, Neon, RDS) needs TLS. Auto-detected from an URL
# containing sslmode=require; force it here if your provider omits that.
DATABASE_SSL=false
